  urldate = {2026-10-04},
  abstract = {The Comment by Nearing et al. (2026) on our earlier work, which included an independent assessment of the performance of Google's global AI flood forecasting system, prompted us to further reflect on responsible AI and numerical modelling more broadly, particularly when models inform high-stakes decisions such as disaster-risk management. While substantial disagreements remain over how operational performance should be evaluated and interpreted, there is important common ground on the need for rigorous evaluation, clearer standards, and model intercomparison. We use this exchange to further discuss evaluation assumptions, communication of model performance, benchmarking, independent scrutiny, and standard-setting, with the aim of contributing to more robust and responsible assessment of models intended for operational decision support.},
