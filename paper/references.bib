@article{sergeEvaluationAllenCoral2024,
  title = {Evaluation of the {{Allen Coral Atlas}} Benthic Habitat Map Product for {{New Caledonia}} Using Representative Habitat Observations from a Multi-Species Fishery Assessment},
  author = {Serge, Andr{\'e}fou{\"e}t and Ma{\"e}le, Brisset and St{\'e}phane, Georget and Antoine, Gilbert},
  year = 2024,
  month = mar,
  journal = {Coral reefs (Online)},
  issn = {1432-0975},
  doi = {10.1007/s00338-024-02481-0},
  urldate = {2024-04-16},
  abstract = {Several remote sensing projects have produced coral reef habitat maps globally. This includes the Allen Coral Atlas (ACA) project. The present study focuses on assessing the accuracy of the ACA 6-class benthic habitat products available for New Caledonia in the 0--10-m depth range. The assessment involves using independent control data collected through thousands of in situ photographs of the benthic environment during sea cucumber stock assessments on multiple sites around New Caledonia. The overall accuracy of the ACA benthic product ranked from 20 to 67\% depending on the sites and evaluation method. These results are generally lower than those achieved by other global and local coral reef mapping and products which can be primarily explained by the lack of local ground-truth data to train the classifications. In addition, we discuss other significant misclassifications immediately detectable through historical knowledge, and the limited relevance of the classification scheme to represent the actual diversity of New Caledonia coral reef habitats, a key criteria to guide conservation with habitat maps. Overall, the study highlights the limitations of the ACA benthic product that users should be aware of and offer some recommendations and caveats for both potential users and map producers in other areas.},
  langid = {english},
  keywords = {Habitat map,Map accuracy assessment,Seagrass,UNESCO World heritage Area}
}

