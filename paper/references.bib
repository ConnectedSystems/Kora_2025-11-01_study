@article{mcgowanAtypicalWeatherPatterns2023,
  title = {Atypical Weather Patterns Cause Coral Bleaching on the {{Great Barrier Reef}}, {{Australia}} during the 2021--2022 {{La Ni\~na}}},
  author = {McGowan, Hamish and Theobald, Alison},
  year = 2023,
  month = apr,
  journal = {Scientific Reports},
  volume = {13},
  number = {1},
  pages = {6397},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-023-33613-1},
  urldate = {2023-09-06},
  abstract = {Widespread coral bleaching was observed over the Great Barrier Reef, Australia, the world's largest coral reef during the 2021--2022 La Ni\~na. This raised concerns that background global warming may have crossed a critical threshold causing thermal stress to corals during a climate state historically associated with increased cloud cover, rainfall and cooler summer water temperatures. Here we present an analysis of recent summer La Ni\~na events focused on their synoptic meteorology and corresponding water temperatures over the Great Barrier Reef. Results show that the 2021--2022 summer La Ni\~na caused accumulated coral heat stress to exceed previous La Ni\~na conditions by 2.5 times. We find that weather patterns that favoured the build-up of heat in water overlying the Great Barrier Reef during the 2021--2022 summer were likely the result of repositioning of planetary scale atmospheric longwaves. This insight provides an additional means to predict potential future atmospheric conditions that increase the risk of extremely high water temperatures and coral bleaching in the Great Barrier Reef.},
  copyright = {2023 The Author(s)},
  langid = {english},
  keywords = {Climate sciences,Environmental sciences}
}

@article{mcintirePERFICTReimaginedFoundation2022,
  title = {{{PERFICT}}: {{A Re}}-Imagined Foundation for Predictive Ecology},
  shorttitle = {{{PERFICT}}},
  author = {McIntire, Eliot J. B. and Chubaty, Alex M. and Cumming, Steven G. and Andison, Dave and Barros, Ceres and Boisvenue, C{\'e}line and Hach{\'e}, Samuel and Luo, Yong and Micheletti, Tatiane and Stewart, Frances E. C.},
  year = 2022,
  journal = {Ecology Letters},
  volume = {25},
  number = {6},
  pages = {1345--1351},
  issn = {1461-0248},
  doi = {10.1111/ele.13994},
  urldate = {2026-03-09},
  abstract = {Making predictions from ecological models---and comparing them to data---offers a coherent approach to evaluate model quality, regardless of model complexity or modelling paradigm. To date, our ability to use predictions for developing, validating, updating, integrating and applying models across scientific disciplines while influencing management decisions, policies, and the public has been hampered by disparate perspectives on prediction and inadequately integrated approaches. We present an updated foundation for Predictive Ecology based on seven principles applied to ecological modelling: make frequent Predictions, Evaluate models, make models Reusable, Freely accessible and Interoperable, built within Continuous workflows that are routinely Tested (PERFICT). We outline some benefits of working with these principles: accelerating science; linking with data science; and improving science-policy integration.},
  copyright = {\copyright{} 2022 Her Majesty the Queen in Right of Canada. Ecology Letters published by John Wiley \& Sons Ltd. Reproduced with the permission of the Minister of Natural Resources Canada.},
  langid = {english},
  keywords = {computational workflows,cross-disciplinary,ecological forecasting,FAIR data,open models,predictive ecology,predictive validation,science-policy integration},
  file = {C\:\\Users\\tiwanaga\\Zotero\\storage\\ACA3VUXS\\McIntire et al. - 2022 - PERFICT A Re-imagined foundation for predictive ecology.pdf;C\:\\Users\\tiwanaga\\Zotero\\storage\\EA8Z3YM8\\ele.html}
}

