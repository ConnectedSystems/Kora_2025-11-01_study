@article{nearingEnsemblesVsInformation2018,
  title = {Ensembles vs. Information Theory: Supporting Science under Uncertainty},
  shorttitle = {Ensembles vs. Information Theory},
  author = {Nearing, Grey S. and Gupta, Hoshin V.},
  year = 2018,
  month = dec,
  journal = {Frontiers of Earth Science},
  volume = {12},
  number = {4},
