@article{hickeyReefHardPlace2020,
  title = {Between a {{Reef}} and a {{Hard Place}}: {{Capacity}} to {{Map}} the {{Next Coral Reef Catastrophe}}},
  shorttitle = {Between a {{Reef}} and a {{Hard Place}}},
  author = {Hickey, Sharyn M. and Radford, Ben and Roelfsema, Chris M. and Joyce, Karen E. and Wilson, Shaun K. and Marrable, Daniel and Barker, Kathryn and Wyatt, Mathew and Davies, Harriet N. and Leon, Javier X. and Duncan, John and Holmes, Thomas H. and Kendrick, Alan J. and Callow, J. Nikolaus and Murray, Kathy},
  year = 2020,
  month = sep,
  journal = {Frontiers in Marine Science},
  volume = {7},
  publisher = {Frontiers},
  issn = {2296-7745},
  doi = {10.3389/fmars.2020.544290},
  urldate = {2024-04-08},
  abstract = {Increasing sea surface temperature and extreme heat events pose the greatest threat to coral reefs globally, with trends exceeding previous norms. The resultant mass bleaching events, such as those evidenced on the Great Barrier Reef in 2016, 2017, and 2020 have substantial ecological costs in addition to economic and social costs. Advancing remote (nanosatellites, rapid revisit traditional satellites) and in-field (drones) technological capabilities, cloud data processing and analysis, coupled with existing infrastructure and in-field monitoring programs have the potential to provide cost-effective and timely information to managers allowing them to better understand changes on reefs and apply effective remediation. Within a risk management framework for coral bleaching, we present an overview of how remote sensing can be used throughout the whole risk management cycle and highlight the role technological advancement has in earth observations of coral reefs for bleaching events.},
  langid = {english},
  keywords = {Climate Change,coral reefs,disaster &amp,Drone,remote sensing,risk management,SST (sea surface temperature)}
}

